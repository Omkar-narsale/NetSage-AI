# NetSage AI - Environment Variable Configuration Template
# Copy this file to .env and insert your Groq API credentials.
# DO NOT commit .env to version control!

# Groq API Key (starts with gsk_...)
GROQ_API_KEY=gsk_your_groq_api_key_here
# Alternatively:
# LLM_API_KEY=gsk_your_groq_api_key_here

# Groq Target Model Name (e.g. llama-3.3-70b-versatile, llama3-70b-8192, mixtral-8x7b-32768)
LLM_MODEL=llama-3.3-70b-versatile

# Groq Base URL (OpenAI-compatible REST API endpoint)
LLM_BASE_URL=https://api.groq.com/openai/v1
